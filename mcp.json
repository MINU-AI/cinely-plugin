{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "cinely": {
      "type": "streamable-http",
      "url": "https://mcp.cinelyai.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": { "mode": "cimd" },
            "baseScopes": ["films:read", "films:write"]
          }
        }
      }
    }
  }
}
